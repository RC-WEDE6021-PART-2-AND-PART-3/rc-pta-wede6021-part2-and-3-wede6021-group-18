<?php
if (session_status() === PHP_SESSION_NONE) { session_start(); }
include 'DBConn.php';

if (!isset($_SESSION['userId'])) {
    header("Location: login.php"); exit();
}

$userId = $_SESSION['userId'];

// Fetch the complete transaction manifest list logged against the active buyer profile
$stmt = $pdo->prepare("SELECT o.orderNum, c.itemName, o.quantity, c.price, o.totalCost, o.orderDate 
                       FROM tblOrder o 
                       JOIN tblClothes c ON o.itemId = c.id 
                       WHERE o.userId = ? 
                       ORDER BY o.id DESC");
$stmt->execute([$userId]);
$historyLines = $stmt->fetchAll();

$accumulatedTotalReportSum = 0;
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><title>Historical Purchase Account Summary Report - Pastimes</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body class="<?= getWatermarkClass() ?>">
<?php include 'navbar.php'; ?>

<div class="container" style="max-width: 950px; margin-top: 40px;">
    <div class="card" style="padding: 40px;">
        <h2 class="card-title">Historical Purchase Account Summary Report</h2>
        <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 25px;">Verifiable financial audit parameters extracted dynamically matching user record keys.</p>

        <?php if (empty($historyLines)): ?>
            <p style="text-align:center; color:var(--text-muted); padding:30px;">No transaction lines logged against this profile account code yet.</p>
        <?php else: ?>
            <table style="width: 100%;">
                <thead>
                    <tr><th>Order Code Number</th><th>Garment Description</th><th>Quantity Purchased</th><th>Unit Price</th><th>Accumulated Row Total</th><th>Timestamp Logged</th></tr>
                </thead>
                <tbody>
                    <?php foreach ($historyLines as $row): 
                        $accumulatedTotalReportSum += $row['totalCost'];
                    ?>
                        <tr>
                            <td><code><?= htmlspecialchars($row['orderNum']) ?></code></td>
                            <td><strong><?= htmlspecialchars($row['itemName']) ?></strong></td>
                            <td><?= $row['quantity'] ?></td>
                            <td>R<?= number_format($row['price'], 2) ?></td>
                            <td style="font-weight: 600;">R<?= number_format($row['totalCost'], 2) ?></td>
                            <td><small style="color:var(--text-muted);"><?= $row['orderDate'] ?></small></td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>

            <div style="margin-top: 35px; border-top: 2px solid #0f172a; padding-top: 20px; text-align: right;">
                <h3 style="font-size: 1.4rem; font-weight: 800; letter-spacing: -0.02em;">
                    Total Collective Expenditure Value: 
                    <span style="color: #16a34a; background: #f0fdf4; padding: 6px 16px; border-radius: 4px; border: 1px solid #bbf7d0; margin-left: 10px;">
                        R<?= number_format($accumulatedTotalReportSum, 2) ?>
                    </span>
                </h3>
            </div>
        <?php endif; ?>
    </div>
</div>
</body>
</html>